{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aris-runtime.example/audit/independent-attestation.schema.json",
  "title": "ARIS-9.6 ULTIMATE External Independent Audit Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "reviewer",
    "reviewed_commit",
    "reviewed_production_domain",
    "review_timestamp",
    "determinations",
    "evidence",
    "limitations",
    "overall",
    "statement"
  ],
  "properties": {
    "audit_id": {"type": "string", "minLength": 8},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "independent_from", "method"],
      "properties": {
        "identity": {"type": "string", "minLength": 2},
        "independent_from": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "method": {"type": "string", "minLength": 10}
      }
    },
    "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_production_domain": {"type": "string", "minLength": 3},
    "review_timestamp": {"type": "string", "format": "date-time"},
    "determinations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normative_oracle_coverage","vlf_semantic_compatibility","text_metrics_semantic_compatibility","production_reproduction","release_gate_5"],
      "properties": {
        "normative_oracle_coverage": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]},
        "vlf_semantic_compatibility": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]},
        "text_metrics_semantic_compatibility": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]},
        "production_reproduction": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]},
        "release_gate_5": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]}
      }
    },
    "evidence": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 3}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "overall": {"enum": ["PASS","FAIL","QUALIFIED","UNVERIFIED"]},
    "statement": {"type": "string", "minLength": 40}
  }
}
